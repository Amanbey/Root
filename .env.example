# ==============================================================================
# ROOT – OFFLINE-FIRST MULTI-AGENT AGRICULTURAL ADVISORY PLATFORM
# Environment Configuration Template
# ==============================================================================

# Supabase (Free Tier Only)
# Get these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Primary AI Engine: Ollama (Local Models Only)
# Default is http://localhost:11434 when running Ollama locally
OLLAMA_BASE_URL=http://localhost:11434
# Preferred local models: llama3.1:8b, qwen2.5:14b, or mistral
OLLAMA_MODEL=llama3.1:8b

# Optional Online AI Engine: Google Gemini (Free Tier Only)
# Optional fallback when online and Ollama is unreachable
GEMINI_API_KEY=

# Application & Regional Defaults
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_COUNTRY=Ethiopia
NEXT_PUBLIC_DEFAULT_LANGUAGE=en
NEXT_PUBLIC_OFFLINE_STORAGE_VERSION=1
